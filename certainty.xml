        <certainty target="#HpMantegnaMiseTombeau" locus="value">
            <desc>
                Deux hypothèses d'identification possibles :
                <objectName ref="#MantegnaMiseAuTombeauQuatreOiseaux"></objectName>, 
                <objectName ref="#MantegnaMiseAuTombeauLargeur"></objectName>.
            </desc>
        </certainty>

        <certainty target="#HpCaraglioNativité" locus="value">
            <desc>
                Trois hypothèses d'identification possibles :
                <objectName ref="#CaraglioViergeJBRaphael"/>, 
                <objectName ref="#CaraglioAdorationBergers"/>, 
                <objectName ref="#CaraglioAnnonciation"/>.
            </desc>
        </certainty>

    </Daret_VieRaphael>

    <Palladio_quattro_libri>
        <certainty target="#PbGaioAurelioCotta">
            <desc>
                Pourrait correspondre au <persName ref="#CaiusAureliusCottaPere">père</persName> ou <persName ref="#CaiusAureliusCottaFils">au fils</persName>.
            </desc>
        </certainty>

    </Palladio_quattro_libri>


